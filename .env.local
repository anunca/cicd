TRAEFIK_VERSION=v3.7.12
TRAEFIK_IMAGE=traefik:${TRAEFIK_VERSION}
GITEA_VERSION=1.27.2
GITEA_IMAGE=gitea/gitea:${GITEA_VERSION}
DOCKER_VERSION=29.7.2
DOCKER_DIND_IMAGE=docker:${DOCKER_VERSION}-dind
DOCKER_CLI_IMAGE=docker:${DOCKER_VERSION}-cli
JENKINS_VERSION=2.583
JENKINS_IMAGE=jenkins/jenkins:${JENKINS_VERSION}-slim
KUBECTL_VERSION=v1.37.0
REGISTRY_VERSION=3.1.1
REGISTRY_IMAGE=registry:${REGISTRY_VERSION}
SONARQUBE_VERSION=26.8.0.126808-community
SONARQUBE_IMAGE=sonarqube:${SONARQUBE_VERSION}
POSTGRES_VERSION=18.6
POSTGRES_IMAGE=postgres:${POSTGRES_VERSION}-alpine

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=cicd
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}

GITEA_HOST=gitea.${DOMAIN_NAME}
JENKINS_HOST=jenkins.${DOMAIN_NAME}
REGISTRY_HOST=registry.${DOMAIN_NAME}
SONARQUBE_HOST=sonarqube.${DOMAIN_NAME}
TRAEFIK_HOST=traefik.${DOMAIN_NAME}

GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
REGISTRY_USER=admin
JENKINS_ADMIN_ID=admin
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar

CICD_NETWORK=cicd

# GITEA_DB_PASSWORD, SONAR_DB_PASSWORD and REGISTRY_PASSWORD are generated locally
# in .env by: make secrets.db secrets.app
