JENKINS_VERSION=jenkins/jenkins:2.561-slim
#JENKINS_VERSION=jenkins/jenkins:2.561-alpine
JENKINS_USER=root
JENKINS_PASS=root

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=jenkins
IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}

JAVA_OPTS='-Djenkins.install.runSetupWizard=false -Dhudson.footerURL=https://jenkins.${DOMAIN_NAME}'
